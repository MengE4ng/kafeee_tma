# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Public HTTPS URL where this server is reachable (ngrok / cloudflared / your domain)
WEBAPP_URL=https://your-domain.com
# Chat ID of the barista group (add the bot to the group, send /chatid)
BARISTA_CHAT_ID=-1001234567890
# Only if the group has topics: send /chatid inside the topic to get its ID
BARISTA_TOPIC_ID=

# --- Shop ---
SHOP_NAME=Kafee
CURRENCY=USD              # USD or KHR (menu prices in src/menu.js use this currency)
TZ=Asia/Phnom_Penh

# --- Payment ---
# manual = show your own merchant QR (below); the barista confirms each payment in Telegram
# bakong = a QR per order via bakong-khqr; payments detected automatically (needs BAKONG_* below)
PAYMENT_MODE=manual
# Your merchant KHQR (the text inside your ABA QR). Already filled in from your QR.
MERCHANT_KHQR="00020101021130510016abaakhppxxx@abaa01151260903202619850208ABA Bank5204581453038405802KH5921NEANG SOKDARA . KAFEE6010PHNOM PENH624268380010PAYWAY@ABA0107195215902090324874206304BEDE"

# --- ABA PayWay (PAYMENT_MODE=payway): payments confirmed automatically ---
# PAYWAY_MERCHANT_ID=your_merchant_id
# PAYWAY_API_KEY=            # the "Public Key" from the PayWay portal (secret! use: npm run secret:set -- PAYWAY_API_KEY)
# PAYWAY_BASE=https://checkout-sandbox.payway.com.kh   # live: the production URL ABA gives you

# --- Bakong / KHQR (only for PAYMENT_MODE=bakong) ---
BAKONG_ACCOUNT_ID=yourname@aclb   # your Bakong account ID (shown in your bank / Bakong app)
MERCHANT_NAME=Kafee                # max 25 chars, shown in the customer's bank app
MERCHANT_CITY=Phnom Penh
# Token from https://api-bakong.nbc.gov.kh (register, then renew before it expires)
BAKONG_TOKEN=eyJhbGciOi...
BAKONG_API=https://api-bakong.nbc.gov.kh
QR_TTL_MIN=15                     # minutes the customer has to pay

# --- Server ---
PORT=3000
DB_PATH=./data.db
# Set to 1 only for local browser testing without Telegram (never in production)
DEV_SKIP_AUTH=0
